#!/usr/bin/python3
"""Root-owned JSON stdin helper for TrustForge Linux certificate activation."""
import base64
import grp
import hashlib
import ipaddress
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path

CONFIG_ROOT = Path("/etc/trustforge/services")
ACTION_FILE = Path("/etc/trustforge/actions.json")
JOB_ROOT = Path("/var/lib/trustforge/jobs")
RELEASE_ROOT = Path("/var/lib/trustforge/releases")
STATE_ROOT = Path("/var/lib/trustforge/state")
MAX_REQUEST = 2 * 1024 * 1024
NAME_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")
GUID_RE = re.compile(r"^[0-9a-f]{32}$")
GUID_D_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


class HelperError(Exception):
    pass


def run(argv):
    result = subprocess.run(argv, text=True, capture_output=True, timeout=45, check=False)
    if result.returncode:
        raise HelperError(f"registered command failed ({result.returncode}): {result.stderr[-1000:]}")
    return result.stdout


def load(path):
    for directory in (path.parent, *path.parent.parents):
        info = directory.stat()
        if info.st_uid != 0 or info.st_mode & 0o022:
            raise HelperError(f"{directory} must be root-owned and not group/world writable")
        if directory == Path("/"):
            break
    info = path.stat()
    if info.st_uid != 0 or info.st_mode & 0o022:
        raise HelperError(f"{path} must be root-owned and not group/world writable")
    with path.open("r", encoding="utf-8") as stream:
        return json.load(stream)


def service_config(service_id):
    config = load(CONFIG_ROOT / f"{service_id}.json")
    required = ("certificatePath", "chainPath", "privateKeyPath", "fileOwner", "fileGroup", "fileMode", "remoteHelperId", "reloadActionId", "healthCheckId")
    if any(not config.get(key) for key in required) or config["remoteHelperId"] != "trustforge-certctl-v1":
        raise HelperError("service registration is incomplete or helper ID is unsupported")
    paths = [Path(config[key]) for key in ("certificatePath", "chainPath", "privateKeyPath")]
    if any(not path.is_absolute() or ".." in path.parts for path in paths) or len({path.parent for path in paths}) != 1:
        raise HelperError("certificate destinations must share one absolute, traversal-free current symlink")
    current = paths[0].parent
    if current.exists() and not current.is_symlink():
        raise HelperError("certificate destination parent exists but is not an atomic symlink")
    if paths[0].name == paths[1].name or paths[0].name == paths[2].name or paths[1].name == paths[2].name:
        raise HelperError("certificate destinations must be distinct")
    if not NAME_RE.fullmatch(config["reloadActionId"]) or not NAME_RE.fullmatch(config["healthCheckId"]):
        raise HelperError("service action identifiers are invalid")
    return config, current, paths


def action(action_id, registry, service_id):
    argv = registry.get(action_id)
    if not isinstance(argv, list) or not argv or any(not isinstance(item, str) for item in argv):
        raise HelperError(f"registered action '{action_id}' is missing")
    run([item.replace("{service_id}", service_id) for item in argv])


def job_directory(service_id, job_id):
    path = JOB_ROOT / service_id / job_id
    path.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(path, 0o700)
    return path


def generate_csr(request):
    sans = request.get("sans")
    if not isinstance(sans, list) or not sans or len(sans) > 100:
        raise HelperError("one to 100 SAN identifiers are required")
    names = []
    for san in sans:
        if not isinstance(san, str) or len(san) > 253:
            raise HelperError("invalid SAN identifier")
        try:
            ipaddress.ip_address(san)
            names.append("IP:" + san)
        except ValueError:
            name = san[2:] if san.startswith("*.") else san
            if not re.fullmatch(r"(?i)[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?", name) or ".." in name:
                raise HelperError("invalid DNS SAN identifier")
            names.append("DNS:" + san)
    job = job_directory(request["serviceId"], request["jobId"])
    key, csr = job / "private-key.pem", job / "request.csr"
    if not key.exists() or not csr.exists():
        run(["openssl", "req", "-new", "-newkey", "rsa:3072", "-nodes", "-keyout", str(key), "-out", str(csr), "-subj", "/CN=" + sans[0], "-addext", "subjectAltName=" + ",".join(names)])
        os.chmod(key, 0o600)
        os.chmod(csr, 0o600)
    return csr.read_text(encoding="ascii")


def pem_der(pem):
    match = re.search(r"-----BEGIN CERTIFICATE-----\s*(.*?)\s*-----END CERTIFICATE-----", pem, re.S)
    if not match:
        raise HelperError("leaf certificate PEM is malformed")
    try:
        return base64.b64decode(re.sub(r"\s", "", match.group(1)), validate=True)
    except ValueError as error:
        raise HelperError("leaf certificate PEM is malformed") from error


def fingerprint(path):
    result = subprocess.run(["openssl", "x509", "-in", str(path), "-outform", "DER"], capture_output=True, timeout=15, check=True)
    return hashlib.sha256(result.stdout).hexdigest().upper()


def atomic_write(path, content, mode):
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".trustforge-", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def stage(request, config, destinations):
    service_id, job_id = request["serviceId"], request["jobId"]
    job = job_directory(service_id, job_id)
    key = job / "private-key.pem"
    if not key.is_file():
        raise HelperError("job private key was not found on the target host")
    leaf = request.get("leafCertificatePem", "").encode("ascii")
    if hashlib.sha256(pem_der(leaf.decode("ascii"))).hexdigest().upper() != request.get("fingerprintSha256", "").upper():
        raise HelperError("issued leaf fingerprint does not match the signing result")
    release_id = job_id
    release = RELEASE_ROOT / service_id / release_id
    release.mkdir(mode=0o700, parents=True, exist_ok=True)
    cert_path, chain_path, key_path = (release / path.name for path in destinations)
    atomic_write(cert_path, leaf, 0o644)
    atomic_write(chain_path, request.get("chainPem", "").encode("ascii"), 0o644)
    atomic_write(key_path, key.read_bytes(), 0o600)
    run(["chown", f"{config['fileOwner']}:{config['fileGroup']}", str(cert_path), str(chain_path), str(key_path)])
    os.chmod(key_path, int(config["fileMode"], 8))
    run(["openssl", "x509", "-in", str(cert_path), "-noout", "-checkend", "0"])
    return release_id


def check_permissions(current, destinations, config):
    owner = pwd.getpwnam(config["fileOwner"]).pw_uid
    group = grp.getgrnam(config["fileGroup"]).gr_gid
    expected = (
        (destinations[0].name, 0o644),
        (destinations[1].name, 0o644),
        (destinations[2].name, int(config["fileMode"], 8)),
    )
    for name, mode in expected:
        info = (current / name).stat()
        if info.st_uid != owner or info.st_gid != group or stat.S_IMODE(info.st_mode) != mode:
            raise HelperError(f"active file '{name}' ownership or permissions do not match the service registration")


def prune(request, service_id, current):
    keep = request.get("retainedReleases")
    if not isinstance(keep, int) or isinstance(keep, bool) or not 1 <= keep <= 50:
        raise HelperError("retainedReleases must be an integer between 1 and 50")
    releases_root = RELEASE_ROOT / service_id
    if not releases_root.is_dir():
        return []
    # The active release and the recorded rollback slot must survive any retention policy.
    protected = set()
    if current.is_symlink():
        protected.add(Path(os.readlink(current)).name)
    state_file = STATE_ROOT / f"{service_id}.json"
    if state_file.exists():
        previous = load(state_file).get("previousTarget")
        if previous:
            protected.add(Path(previous).name)
    candidates = [entry for entry in releases_root.iterdir() if entry.is_dir() and GUID_RE.fullmatch(entry.name)]
    candidates.sort(key=lambda entry: entry.stat().st_mtime, reverse=True)
    protected.update(entry.name for entry in candidates[:keep])
    pruned = []
    for entry in candidates:
        if entry.name in protected:
            continue
        shutil.rmtree(entry)
        job = JOB_ROOT / service_id / entry.name
        if job.is_dir():
            shutil.rmtree(job)
        pruned.append(entry.name)
    return pruned


def set_link(current, target):
    # First activation: the destination parent may not exist yet (service_config allows this).
    current.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    temporary = current.parent / (".trustforge-link-" + str(os.getpid()))
    temporary.unlink(missing_ok=True)
    if target is not None:
        temporary.symlink_to(target)
        os.replace(temporary, current)
    else:
        current.unlink(missing_ok=True)


def main(request):
    service_id, job_id = request.get("serviceId", ""), request.get("jobId", "")
    if not isinstance(service_id, str) or not (GUID_RE.fullmatch(service_id) or GUID_D_RE.fullmatch(service_id)):
        raise HelperError("service and job IDs must be canonical GUIDs")
    if job_id:
        if not isinstance(job_id, str) or not (GUID_RE.fullmatch(job_id) or GUID_D_RE.fullmatch(job_id)):
            raise HelperError("service and job IDs must be canonical GUIDs")
        job_id = job_id.replace("-", "")
    service_id = service_id.replace("-", "")
    request["serviceId"], request["jobId"] = service_id, job_id
    config, current, destinations = service_config(service_id)
    registry = load(ACTION_FILE)
    operation = request.get("operation")
    if operation == "validate":
        action(config["healthCheckId"], registry, service_id)
        return {"success": True}
    if operation == "generate-csr":
        return {"success": True, "csrPem": generate_csr(request)}
    if operation == "stage":
        return {"success": True, "releaseId": stage(request, config, destinations)}
    if operation == "prune":
        return {"success": True, "prunedReleaseIds": prune(request, service_id, current)}

    release_id = request.get("releaseId", "")
    if not GUID_RE.fullmatch(release_id):
        raise HelperError("release ID is invalid")
    release = RELEASE_ROOT / service_id / release_id
    state_file = STATE_ROOT / f"{service_id}.json"
    if operation == "activate":
        if not release.is_dir():
            raise HelperError("staged certificate release does not exist")
        existing_state = load(state_file) if state_file.exists() else {}
        if current.is_symlink() and Path(os.readlink(current)).resolve() == release.resolve() and existing_state.get("releaseId") == release_id:
            previous = existing_state.get("previousTarget")
        else:
            previous = os.readlink(current) if current.is_symlink() else None
        STATE_ROOT.mkdir(mode=0o700, parents=True, exist_ok=True)
        atomic_write(state_file, json.dumps({"releaseId": release_id, "previousTarget": previous}).encode(), 0o600)
        set_link(current, release)
        try:
            action(config["reloadActionId"], registry, service_id)
        except Exception:
            set_link(current, previous)
            if previous:
                action(config["reloadActionId"], registry, service_id)
            raise
        return {"success": True, "previousReleaseId": Path(previous).name if previous else None}
    if operation == "verify":
        if not current.is_symlink() or Path(os.readlink(current)).resolve() != release.resolve():
            raise HelperError("active certificate release does not match the requested release")
        actual = fingerprint(current / destinations[0].name)
        if actual != request.get("expectedFingerprint", "").upper():
            raise HelperError("active certificate fingerprint does not match the issued certificate")
        check_permissions(current, destinations, config)
        action(config["healthCheckId"], registry, service_id)
        return {"success": True}
    if operation == "rollback":
        state = load(state_file)
        if state.get("releaseId") != release_id:
            raise HelperError("release is not the currently recorded activation")
        previous = state.get("previousTarget")
        set_link(current, previous)
        action(config["reloadActionId"], registry, service_id)
        action(config["healthCheckId"], registry, service_id)
        return {"success": True, "previousReleaseId": Path(previous).name if previous else None}
    raise HelperError("operation is unsupported")


try:
    helper_info = Path(__file__).stat()
    if helper_info.st_uid != 0 or helper_info.st_mode & 0o022:
        raise HelperError("helper executable must be root-owned and not group/world writable")
    raw = sys.stdin.buffer.read(MAX_REQUEST + 1)
    if len(raw) > MAX_REQUEST:
        raise HelperError("request exceeds maximum size")
    answer = main(json.loads(raw))
    sys.stdout.write(json.dumps(answer, separators=(",", ":")) + "\n")
except Exception as error:
    sys.stdout.write(json.dumps({"success": False, "error": str(error)[:2000]}, separators=(",", ":")) + "\n")
    sys.exit(1)
