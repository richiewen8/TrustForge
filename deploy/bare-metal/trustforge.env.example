# TrustForge runtime configuration for a bare-metal (systemd) deployment.
#
# deploy/bare-metal/install.sh generates /etc/trustforge/trustforge.env from this file and
# substitutes every __TF_*__ sentinel. If you maintain the file by hand, replace the sentinels
# before the first start: an unexpanded sentinel makes the API fail to authenticate, not degrade.
#
# systemd parses this file WITHOUT shell expansion and WITHOUT inline comments. Keep every
# comment on its own line, and do not wrap values in quotes that the .NET configuration binder
# would then see as literal characters.
#
# File ownership and permissions: /etc/trustforge/trustforge.env is mode 0640 (rw-r-----) owned by
# root:trustforge. This file contains secrets (OIDC authority URLs, API tokens, database passwords)
# and must not be readable by users other than trustforge. The parent directory
# /etc/trustforge/ is mode 0750 (rwxr-x---) owned by root:trustforge to enforce access control.
# Secret references (SmallstepAcme__AccountKeySecretRef, TechnitiumDns__ApiTokenSecretRef) point to
# files in /etc/trustforge/secrets which is mode 0750, also read-only from the trustforge service
# perspective (ProtectSystem=strict in trustforge.service).

# --- Host ---
ASPNETCORE_ENVIRONMENT=Production
# Loopback on purpose: there is no TLS in TrustForge.Api, so expose the API through a reverse
# proxy that terminates TLS. The OIDC authority must therefore be reachable over HTTPS.
# http://+:5000 on a physical machine publishes unauthenticated-transport plaintext to every
# interface. Only change this together with a firewall rule and a proxy in front.
ASPNETCORE_URLS=http://127.0.0.1:5000

# --- Persistence (required; the API throws without it) ---
# Keep the password hex: it must survive both systemd parsing and Npgsql connection-string
# parsing, where ';' and '=' are delimiters.
ConnectionStrings__TrustForge=Host=127.0.0.1;Port=5432;Database=trustforge;Username=trustforge;Password=__TF_DB_PASSWORD__

# --- Authentication (required; the API throws unless the authority is HTTPS) ---
Authentication__Authority=__TF_OIDC_AUTHORITY__
Authentication__Audience=__TF_OIDC_AUDIENCE__
# Development only: uncomment with ASPNETCORE_ENVIRONMENT=Development for loopback HTTP OIDC.
# Authentication__AllowInsecureLoopback=false

# --- Embedded DNS engine ---
DnsServer__Enabled=true
DnsServer__ConfigDirectory=/etc/trustforge/dns

# =============================================================================
# FROZEN AT FIRST START - READ THIS BEFORE EDITING ANY LINE IN THIS BLOCK
#
# The DNS engine reads DNS_SERVER_* only while the matching config file does not exist
# (DnsServerCore/DnsWebService.cs:276-346, DnsServerCore/Dns/DnsServer.cs:472-599,
# DnsServerCore/Auth/AuthManager.cs:950-951). It then writes dns.config, webservice.config and
# auth.config and reads only those forever after. Editing this block afterwards is a silent
# no-op: the service keeps running with the values it froze at first boot.
#
# There is NO environment variable that moves the DNS listener off port 53, so port 53 must be
# free before the first start; a failed bind terminates the whole process
# (TrustForge.Api/DnsServerHostedService.cs:24 passes throwIfBindFails: true).
#
# To change a frozen value: stop the service, archive /etc/trustforge/dns (zones, the DNS-01
# challenge zone, API tokens and locally created users are all inside it), and start again with
# an empty directory. See BAREMETAL.md.
# =============================================================================

# The DNS administration console defaults to 0.0.0.0:5380 (DnsWebService.cs:105,108). Under
# Docker the "127.0.0.1:" host mapping was the only thing keeping it off the wire; on a physical
# host nothing does, so bind it here.
DNS_SERVER_WEB_SERVICE_LOCAL_ADDRESSES=127.0.0.1
DNS_SERVER_WEB_SERVICE_HTTP_PORT=5380

# Without this file the engine creates the administrator as admin/admin. /etc/trustforge/secrets
# is deliberately outside the unit's ReadWritePaths, so ProtectSystem=strict makes it read-only
# for the service: the API writes keys to its targets, never to its own secret store.
DNS_SERVER_ADMIN_PASSWORD_FILE=/etc/trustforge/secrets/dns-admin-password

# Recursion restricted to private networks is also the code default; stated so the frozen value
# is visible rather than implicit.
DNS_SERVER_RECURSION=AllowOnlyForPrivateNetworks
# A blocklist enabled at first boot silently swallows _acme-challenge lookups and OIDC discovery.
DNS_SERVER_ENABLE_BLOCKING=false
DNS_SERVER_LOG_FOLDER_PATH=/var/log/technitium/dns
# Bare metal has no volume prune behind it: cap growth explicitly.
DNS_SERVER_LOG_MAX_LOG_FILE_DAYS=30
DNS_SERVER_STATS_MAX_STAT_FILE_DAYS=90

# =============================================================================
# Certificate pipeline (all optional at startup; each unset value makes the matching job fail
# at execution time rather than preventing boot)
# =============================================================================

# The durable job queue worker. Leave false until the ACME and DNS settings below are complete:
# a job that cannot run stays queued, while a half-configured pipeline produces failed attempts.
CertificateJobs__Worker__Enabled=false
CertificateJobs__Worker__PollInterval=00:00:02
CertificateJobs__Worker__NotificationEnabled=true
CertificateJobs__Worker__LeaseDuration=00:02:00
CertificateJobs__Artifacts__Directory=/var/lib/trustforge/artifacts

# Revocation is a separate worker. If it is disabled, or no CA account key is readable, a
# requested revocation stays Pending forever: requested is not revoked.
CertificateJobs__Revocation__Enabled=true
CertificateJobs__Revocation__PollInterval=00:00:10
CertificateJobs__Revocation__VisibilityTimeout=00:02:00
CertificateJobs__Revocation__MaxAttempts=5
CertificateJobs__Deployment__RetainedReleases=3

CertificateJobs__Renewal__ScanInterval=00:05:00
CertificateJobs__Renewal__MinimumRenewalInterval=01:00:00
CertificateJobs__Expiry__ScanInterval=01:00:00
CertificateJobs__Expiry__ReminderWindow=7.00:00:00
CertificateJobs__Alerts__WebhookUrl=

# --- step-ca ACME ---
SmallstepAcme__DirectoryUrl=
SmallstepAcme__AccountEmail=
# secret://file// requires the double slash: the remainder must parse as an absolute path, and
# on bare metal that path is a host path read by the trustforge service user
# (TrustForge.Api/EnvironmentSecretResolver.cs:12-19). There is no ownership or permission check,
# so the file mode is the only gate: keep 0640 root:trustforge inside 0750 root:trustforge.
SmallstepAcme__AccountKeySecretRef=
SmallstepAcme__EabKeyId=
SmallstepAcme__EabKeySecretRef=
# Issued certificates are validated against this root before deployment. Required for issuance.
SmallstepAcme__RootCertificatePath=

# --- DNS-01 challenge through the embedded engine ---
TechnitiumDns__BaseUrl=http://127.0.0.1:5380
TechnitiumDns__ApiTokenSecretRef=
TechnitiumDns__AllowedZones__0=
TechnitiumDns__ResolverAddress=127.0.0.1
TechnitiumDns__ResolverPort=53

# --- External Technitium DNS-01 challenge (optional, for remote DNS server) ---
# Use these if you want to delegate DNS-01 challenges to an external Technitium DNS server
# (e.g., deployed on a separate machine). Leave empty to use the embedded engine above.
ACME_DNS_HOST=
ACME_DNS_PORT=53
ACME_DNS_ZONE=_acme-challenge
# File mode 0640 root:trustforge inside 0750 root:trustforge; see SmallstepAcme__AccountKeySecretRef comment above
ACME_DNS_TOKEN=
