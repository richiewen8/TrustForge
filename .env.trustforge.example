# Copy to .env before starting Docker Compose. Use a unique strong database password.
POSTGRES_PASSWORD=replace-with-a-long-random-secret

# HTTPS OIDC issuer reachable from inside the TrustForge container, and configured API audience.
TRUSTFORGE_OIDC_AUTHORITY=https://identity.example.internal/realms/trustforge
TRUSTFORGE_OIDC_AUDIENCE=trustforge-api

# Optional host ports and DNS console bind address.
TRUSTFORGE_API_PORT=5000
TRUSTFORGE_DNS_PORT=53
TRUSTFORGE_DNS_UI_BIND=127.0.0.1
TRUSTFORGE_DNS_UI_PORT=5380
TRUSTFORGE_WORKER_ENABLED=false
TRUSTFORGE_SIMULATION_ENABLED=false
TRUSTFORGE_ACME_DIRECTORY_URL=https://step-ca.example.internal/acme/trustforge/directory
TRUSTFORGE_ACME_ACCOUNT_EMAIL=trustforge@internal.example
# For the environment resolver, use secret://env/NAME in the application setting and provide the value securely at runtime.
TRUSTFORGE_ACME_ACCOUNT_KEY_REF=secret://env/TRUSTFORGE_ACME_ACCOUNT_KEY_PEM
TRUSTFORGE_ACME_EAB_KEY_ID=
TRUSTFORGE_ACME_EAB_KEY_REF=
TRUSTFORGE_ACME_ROOT_CERT_PATH=
TRUSTFORGE_TECHNITIUM_API_URL=http://127.0.0.1:5380
TRUSTFORGE_TECHNITIUM_API_TOKEN_REF=secret://env/TRUSTFORGE_TECHNITIUM_API_TOKEN
TRUSTFORGE_DNS_CHALLENGE_ZONE_0=internal.example
TRUSTFORGE_DNS_CHALLENGE_RESOLVER_ADDRESS=127.0.0.1
TRUSTFORGE_DNS_CHALLENGE_RESOLVER_PORT=53
TRUSTFORGE_WORKER_POLL_INTERVAL=00:00:02
TRUSTFORGE_WORKER_LEASE_DURATION=00:02:00
# Host directory bind-mounted read-only at /run/trustforge/secrets, holding the files that
# secret://file//run/trustforge/secrets/<name> references (ACME account key, DNS API token, and one
# {"username","privateKeyPem"} JSON per service). Alternative: keep the compose default ./secrets.
TRUSTFORGE_SECRETS_DIR=./secrets
# Revocations stay pending until a worker with the CA account key delivers them.
TRUSTFORGE_REVOCATION_ENABLED=true
TRUSTFORGE_REVOCATION_POLL_INTERVAL=00:00:10
TRUSTFORGE_REVOCATION_VISIBILITY_TIMEOUT=00:02:00
TRUSTFORGE_REVOCATION_MAX_ATTEMPTS=5
# Releases kept on each target after a verified deployment (active and rollback slots are always kept).
TRUSTFORGE_RETAINED_RELEASES=3
