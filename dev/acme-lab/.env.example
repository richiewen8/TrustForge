# Copy to .env and replace every REPLACE_WITH_* value with a long random local password.
# The lab is for isolated development only; never reuse these values in production.
LAB_SUBNET_PREFIX=172.30.90
# Windows may reserve port ranges (netsh interface ipv4 show excludedportrange);
# pick host ports outside them if binding fails.
LAB_API_PORT=5080
LAB_DNS_UI_PORT=5780
LAB_OIDC_PORT=8280
LAB_TARGET_SSH_PORT=2222
LAB_TARGET_TLS_PORT=8443
LAB_STEP_CA_TAG=0.30.2

LAB_POSTGRES_DB=trustforge_lab
LAB_POSTGRES_USER=trustforge
LAB_POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_LOCAL_PASSWORD
LAB_DNS_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_LOCAL_PASSWORD
LAB_DNS_ACME_PASSWORD=REPLACE_WITH_A_THIRD_LONG_RANDOM_LOCAL_PASSWORD
LAB_STEP_CA_PASSWORD=REPLACE_WITH_A_FOURTH_LONG_RANDOM_LOCAL_PASSWORD

LAB_OIDC_ADMIN_USER=trustforge-admin
LAB_OIDC_ADMIN_PASSWORD=REPLACE_WITH_A_FIFTH_LONG_RANDOM_LOCAL_PASSWORD
LAB_OIDC_DEV_USERNAME=trustforge-operator
LAB_OIDC_DEV_EMAIL=trustforge-operator@trustforge-dev.local
LAB_OIDC_DEV_PASSWORD=REPLACE_WITH_A_SIXTH_LONG_RANDOM_LOCAL_PASSWORD