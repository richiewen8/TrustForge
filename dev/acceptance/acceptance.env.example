# Copy to acceptance.env (gitignored) and fill in. preflight.sh reads only this file and hosts.json;
# it never sends secret values anywhere except the endpoints they belong to.

# ---- TrustForge control plane -------------------------------------------------
# API base URL of the local compose stack that will run the drill.
TF_API_URL=http://127.0.0.1:5000
# Token endpoint of the real OIDC issuer configured as Authentication__Authority.
TF_OIDC_TOKEN_URL=https://identity.example.internal/realms/trustforge/protocol/openid-connect/token
TF_OIDC_CLIENT_ID=trustforge-cli
# Authentication__Audience configured on the API.
TF_OIDC_AUDIENCE=trustforge-api
# The drill account must hold PlatformAdmin: revocation is restricted to it.
TF_OPERATOR_USERNAME=trustforge-operator
TF_OPERATOR_PASSWORD=

# ---- Real CA ------------------------------------------------------------------
TF_ACME_DIRECTORY_URL=https://ca.internal.example.internal/acme/trustforge/directory
# step-ca root certificate (the same PEM the API verifies issued chains against).
TF_ACME_ROOT_CA_FILE=secrets/root_ca.crt
# ACME account EC P-256 key in PKCS#8 PEM. Generate:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out secrets/acme-account.pem
TF_ACME_ACCOUNT_KEY_FILE=secrets/acme-account.pem
TF_ACME_ACCOUNT_EMAIL=trustforge@internal.example.internal
# Optional: connect to the CA by IP while still verifying the hostname in
# TF_ACME_DIRECTORY_URL -- tlsfetch.py only changes the address that is opened, so
# certificate name matching and verification against TF_ACME_ROOT_CA_FILE are untouched.
TF_CA_RESOLVE_IP=
# Optional: the CA's CRL endpoint. step-ca serves /1.0/crl only when the "crl" block in
# its provisioner JSON is enabled and the CA has been restarted.
TF_CRL_URL=

# ---- Real Technitium DNS ------------------------------------------------------
TF_TECHNITIUM_URL=http://127.0.0.1:5380
# Least-privilege API token (View/Modify/Delete on the challenge zone only).
TF_TECHNITIUM_TOKEN_FILE=secrets/dns-api-token
TF_DNS_ALLOWED_ZONE=internal.example.internal
# The resolver the API polls for TXT propagation, and the resolver step-ca must use too.
TF_DNS_RESOLVER=127.0.0.1
TF_DNS_RESOLVER_PORT=53
# Set to skip when the resolver only answers from the API/CA network (for example a loopback
# listener inside the compose network namespace) and cannot be reached from this workstation.
TF_DNS_RESOLVER_PROBE=dns

# ---- Targets ------------------------------------------------------------------
# JSON inventory consumed by preflight.sh and drill.sh.
TF_HOSTS_FILE=hosts.json
# Host-side directory that the compose stack mounts at /run/trustforge/secrets, so the
# secret://file//run/trustforge/secrets/<name> references can be checked before issuance.
TF_SECRETS_DIR=secrets

# ---- Drill behaviour ----------------------------------------------------------
TF_JOB_TIMEOUT_SECONDS=600
# The drill revokes only the certificate it minted itself. Set false to stop after issuance.
TF_REVOKE_AFTER=true
TF_REVOCATION_REASON=Superseded
# Optional: an executable that installs the target-side registration drill.sh prints, so the run
# needs no terminal. Called as: HOOK NAME SERVICE_ID REGISTRATION_JSON_PATH TARGET_PATH.
# Writing that file stays an operator-side act (the API never learns of it); see lab-install.sh.
TF_TARGET_READY_HOOK=
# Set when the API is served over TLS from a private CA; used for every control-plane call.
TF_API_CA_FILE=
TF_OUT_DIR=out
# Waits, per host. A CA that lacks crl.generateOnRevoke only republishes on its own schedule, so
# raise TF_CRL_PROPAGATION_SECONDS to that interval rather than reading a timeout as a lost revocation.
TF_REVOCATION_TIMEOUT_SECONDS=180
TF_CRL_PROPAGATION_SECONDS=180
# After revoking, mint one more certificate to prove the service still works. The lab self-test
# enables this so the target is left serving a valid certificate.
TF_REISSUE_AFTER_REVOKE=false
