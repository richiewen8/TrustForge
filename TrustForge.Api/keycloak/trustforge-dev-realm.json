{
  "realm": "trustforge-dev",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "PlatformAdmin" },
      { "name": "CertificateOperator" },
      { "name": "Auditor" }
    ]
  },
  "clients": [
    {
      "clientId": "trustforge-api",
      "name": "TrustForge API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "trustforge-cli",
      "name": "TrustForge local development client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": ["trustforge-api-access"],
      "protocolMappers": [
        {
          "name": "trustforge-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "trustforge-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "trustforge-flat-realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "role",
            "jsonType.label": "String",
            "multivalued": "true",
            "userinfo.token.claim": "false",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "trustforge-subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clientScopes": [
    {
      "name": "trustforge-api-access",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "users": [
    {
      "username": "${TF_OIDC_DEV_USERNAME}",
      "email": "${TF_OIDC_DEV_EMAIL}",
      "firstName": "TrustForge",
      "lastName": "Operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${TF_OIDC_DEV_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["PlatformAdmin"]
    },
    {
      "username": "trustforge-cert-operator",
      "email": "trustforge-cert-operator@trustforge-dev.local",
      "firstName": "TrustForge",
      "lastName": "Certificate Operator",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${TF_OIDC_DEV_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": ["CertificateOperator"]
    }
  ]
}
