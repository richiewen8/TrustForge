<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>TrustForge.Api</RootNamespace>
    <AssemblyName>TrustForge</AssemblyName>
    <Product>TrustForge</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <ProjectReference Include="..\DnsServerCore\DnsServerCore.csproj" />
    <ProjectReference Include="..\TrustForge.Core\TrustForge.Core.csproj" />
    <ProjectReference Include="..\TrustForge.Persistence\TrustForge.Persistence.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageReference Include="Certes" Version="4.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
